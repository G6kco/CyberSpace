APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

DATABASE_URL=

# Must be the exact origin the browser loads the client from: it is the
# redirect target after sign-in and the only Origin allowed to end a session.
FRONTEND_URL=http://localhost:5173
# Required for the client's credentialed fetch calls. An empty value disables
# CORS entirely, which makes /api/v1/me fail from the browser.
CORS_ORIGIN_ALLOWED=http://localhost:5173

SESSION_SECRET=REPLACE_THIS_WITH_A_VALID_SECRET

GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
# Your Google Workspace domain. Sign-in compares this with the "hd" claim,
# which Google sends only for Workspace accounts, so personal Gmail accounts
# are always refused.
GOOGLE_ALLOWED_DOMAIN=college.example.edu
# The path must be exactly /api/v1/auth/google/callback; config validation
# rejects anything else.
GOOGLE_CALL_BACK=http://localhost:8080/api/v1/auth/google/callback

DOCKER_HOST=

# Key for the HMACs that expected flags are stored as; at least 32 bytes.
# Generate once (for example: openssl rand -hex 32) and never change it after
# importing questions, or every stored flag stops matching.
ANSWER_HMAC_KEY=

# Directory of the Wireshark capture files; defaults to storage/pcaps,
# relative to the directory the API is started from.
PCAP_DIR=
